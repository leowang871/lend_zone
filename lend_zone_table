<body>
  <div id="root"></div>
  
  <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

<script type="text/babel" src="js/shell.js"></script>
  <script type="text/babel" src="js/components.jsx"></script>
  <script type="text/babel" src="js/screens.js"></script>
  <script type="text/babel">
    function App() {
      const [state, setState] = React.useState({
        loggedIn: true,
        route: 'ops/day-trading-buyback',
        modal: null,
        notice: null,
      });

      const navigate = id => setState(s => ({ ...s, route: id, notice: null }));
      const logout = () => setState({ loggedIn: false, route: 'home', modal: null, notice: null });

      if (!state.loggedIn) return <Login setState={setState}/>;

      const ScreenMap = {
        'home':         Dashboard,
        'review/open':  ReviewQueue,
        'review/happy': ReviewQueue,
        'ops/discount': CampaignList,
        'ops/upload':   UploadForm,
        'ops/day-trading-buyback': DayTradingBuyback,
        'push':         PushCompose,
      };
      const Screen = ScreenMap[state.route] ?? Dashboard;

      return (
        <div data-screen-label={`CMS · ${state.route}`}>
          <Shell active={state.route} onNavigate={navigate} onLogout={logout}>
            <Screen state={state} setState={setState}/>
          </Shell>

          <Modal
            open={state.modal === 'confirm-upload'}
            onClose={() => setState(s => ({ ...s, modal: null }))}
            title="確認送出？"
            actions={
              <>
                <Button variant="secondary" onClick={() => setState(s => ({ ...s, modal: null }))}>取消</Button>
                <Button variant="primary" onClick={() => setState(s => ({ ...s, modal: null, route: 'ops/discount', notice: '名單已上傳並進入簽核流程。' }))}>確認送出</Button>
              </>
            }
          >
            送出後將通知所有 287 位用戶，<br/>此操作無法復原。
          </Modal>

          <Modal
            open={state.modal === 'confirm-push'}
            onClose={() => setState(s => ({ ...s, modal: null }))}
            title="送出簽核？"
            actions={
              <>
                <Button variant="secondary" onClick={() => setState(s => ({ ...s, modal: null }))}>取消</Button>
                <Button variant="primary" onClick={() => setState(s => ({ ...s, modal: null, route: 'home', notice: '推播已送至簽核流程。' }))}>確認送簽</Button>
              </>
            }
          >
            「{state._pushTitle}」<br/>將送至營運主管簽核，預計 1–2 工作日內生效。
          </Modal>

          <Modal
            open={state.modal === 'detail'}
            onClose={() => setState(s => ({ ...s, modal: null }))}
            title="申請明細"
            actions={
              <>
                <Button variant="secondary" onClick={() => setState(s => ({ ...s, modal: null }))}>關閉</Button>
                <Button variant="primary" onClick={() => setState(s => ({ ...s, modal: null }))}>通過審核</Button>
              </>
            }
          >
            這是一個範例彈窗，<br/>實際的申請明細包含個資、開戶資料、Happy Call 紀錄。
          </Modal>
        </div>
      );
    }
    ReactDOM.createRoot(document.getElementById('root')).render(<App/>);
  </script>
</body></html>
