/* ── Breakpoints ───────────────────────────────────────────────── */

/* 內容預覽：中大屏 */
@media (max-width: 1280px) {
  .cms-main {
    padding: 32px 24px 40px;
  }

  .dtb-content-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 1024px) {
  .cms-shell {
    grid-template-columns: 1fr;
    grid-template-rows: 60px auto 1fr;
    grid-template-areas:
      "header"
      "side"
      "main";
  }

  .cms-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .cms-header {
    padding-left: 16px;
    padding-right: 16px;
  }

  .cms-header__user {
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 40vw;
  }

  .cms-sidebar {
    position: fixed;
    top: 60px;
    left: 0;
    bottom: 0;
    width: min(280px, 88vw);
    transform: translateX(-100%);
