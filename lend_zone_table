  margin-bottom: 0;
}

.dtb-edit-times {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
}

.dtb-edit-times__list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.dtb-edit-times__row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.dtb-edit-times__row .dtb-time-picker {
  flex: 1;
  width: auto;
  max-width: none;
}

.dtb-edit-times__remove {
  flex-shrink: 0;
  border: none;
  background: transparent;
  color: rgb(233, 84, 101);
  font-size: 13px;
  cursor: pointer;
  text-decoration: underline;
  padding: 6px 4px;
  font-family: "PingFang TC", "Noto Sans TC", sans-serif;
  white-space: nowrap;
}

.dtb-edit-times__remove:disabled {
  color: rgb(113, 112, 113);
  cursor: not-allowed;
  text-decoration: none;
}

.dtb-edit-times__add {
  align-self: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 4px;
  padding: 10px 28px;
  border: 1px solid rgb(233, 84, 101);
  border-radius: 999px;
  background: #fff;
  color: rgb(233, 84, 101);
  font-size: 15px;
  font-weight: 500;
  line-height: 1;
  cursor: pointer;
  font-family: "PingFang TC", "Noto Sans TC", sans-serif;
  white-space: nowrap;
  transition: background 0.15s ease;
}

.dtb-edit-times__add:hover {
  background: rgb(251, 227, 227);
}

.dtb-edit-times__add-icon {
  font-size: 18px;
  font-weight: 400;
  line-height: 1;
}

.dtb-content-card__meta {
  font-size: 12px;
  color: rgb(113, 112, 113);
  margin: 0 0 8px;
}

.dtb-content-card__text {
  white-space: pre-wrap;
  word-break: break-word;
}

.dtb-edit-modal__body {
  padding: 28px 32px 8px;
}

.dtb-edit-modal__label {
  display: block;
  margin-bottom: 12px;
  font-size: 16px;
  font-weight: 500;
  color: #000;
}

.dtb-edit-modal__input {
  width: 100%;
  height: 44px;
  margin-bottom: 20px;
  padding: 10px 16px;
  border: 1px solid rgb(200, 201, 202);
