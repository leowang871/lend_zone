  box-sizing: border-box;
  outline: none;
}

.dtb-edit-modal__textarea:focus {
  border-color: rgb(233, 84, 101);
}

.dtb-edit-modal__actions {
  display: flex;
  justify-content: center;
  gap: 20px;
  padding: 24px 32px 32px;
}

.dtb-edit-modal__btn {
  min-width: 120px;
  height: 44px;
  padding: 0 28px;
  border-radius: 8px;
  font-size: 17px;
